# ── AI / Voice providers ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL    # default: "Sarah" - calm, low pitch
DEEPGRAM_API_KEY=...

# ── Supabase (use EU region project for GDPR) ────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...                       # public, used by mobile
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # server-only, never ship

# ── Runtime ──────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SESSION_MAX_MINUTES=30
RATE_LIMIT_SESSION_STARTS_PER_HOUR=6

# ── Mobile (Expo `extra` injection) ──────────────────────────────────
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
